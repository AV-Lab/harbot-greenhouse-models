      <pose>0 21.6666 0 0 0 0</pose>
    </include>

    <include>
      <uri>model://orange_left</uri>
      <name>orange1.8.L</name>
      <pose>0 25.2777 0 0 0 0</pose>
    </include>

    <!-- oranges row 1 right -->
