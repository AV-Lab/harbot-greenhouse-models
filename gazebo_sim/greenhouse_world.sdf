    <!-- Green exterior floor from the updated greenhouse model. -->
    <model name="green_floor">
      <static>true</static>
      <link name="body">
        <collision name="collision">
          <pose>0 0 0 1.57079632679 0 0</pose>
          <geometry>
            <mesh>
              <uri>assets/greenhouse/meshes/greenhouse_green.obj</uri>
              <scale>1 1 1</scale>
            </mesh>
          </geometry>
        </collision>
        <visual name="visual">
          <pose>0 0 0 1.57079632679 0 0</pose>
          <geometry>
            <mesh>
              <uri>assets/greenhouse/meshes/greenhouse_green.obj</uri>
              <scale>1 1 1</scale>
            </mesh>
          </geometry>
        </visual>
      </link>
    </model>

